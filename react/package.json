{
  "name": "@soujvnunes/react",
  "version": "0.2.0",
  "description": "React utilities — hooked-context factory, error boundary, motion helpers (subpath exports, optional peers).",
  "license": "MIT",
  "author": "soujvnunes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soujvnunes/packages.git",
    "directory": "react"
  },
  "type": "module",
  "exports": {
    "./createHookedContext": {
      "types": "./dist/createHookedContext.d.ts",
      "default": "./dist/createHookedContext.js"
    },
    "./ErrorBoundary": {
      "types": "./dist/ErrorBoundary.d.ts",
      "default": "./dist/ErrorBoundary.js"
    },
    "./motion": {
      "types": "./dist/motion.d.ts",
      "default": "./dist/motion.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup createHookedContext.ts ErrorBoundary.tsx motion.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "motion": ">=11",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "motion": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "motion": "^11.18.0",
    "react": "^19.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
