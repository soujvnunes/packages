{
  "name": "@soujvnunes/prettier-config",
  "version": "0.3.0",
  "description": "Shared Prettier config factory.",
  "license": "MIT",
  "author": "soujvnunes",
  "keywords": [
    "prettier",
    "prettier-config",
    "prettierconfig",
    "prettier-plugin-tailwindcss",
    "tailwindcss",
    "formatter",
    "code-style",
    "config"
  ],
  "homepage": "https://github.com/soujvnunes/packages/tree/main/prettier-config#readme",
  "bugs": "https://github.com/soujvnunes/packages/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soujvnunes/packages.git",
    "directory": "prettier-config"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "prettier-plugin-tailwindcss": "^0.7.2"
  },
  "peerDependencies": {
    "prettier": ">=3"
  },
  "devDependencies": {
    "@types/node": "^20.19.39"
  },
  "publishConfig": {
    "access": "public"
  }
}
