{
  "name": "@soujvnunes/ui",
  "version": "0.0.0",
  "description": "Unstyled React component skeletons that a product themes through CSS custom properties.",
  "license": "MIT",
  "author": "soujvnunes",
  "keywords": [
    "react",
    "components",
    "design-system",
    "unstyled",
    "css-variables"
  ],
  "homepage": "https://github.com/soujvnunes/packages/tree/main/ui#readme",
  "bugs": "https://github.com/soujvnunes/packages/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soujvnunes/packages.git",
    "directory": "ui"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
