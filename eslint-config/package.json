{
  "name": "@soujvnunes/eslint-config",
  "version": "0.3.0",
  "description": "Shared flat ESLint config factories (base + Next.js).",
  "license": "MIT",
  "author": "soujvnunes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soujvnunes/packages.git",
    "directory": "eslint-config"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "^16.2.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-helpers": "^2.0.1",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.4.0",
    "typescript-eslint": "^8.58.0"
  },
  "peerDependencies": {
    "eslint": ">=9",
    "typescript": ">=5.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.39"
  },
  "publishConfig": {
    "access": "public"
  }
}
